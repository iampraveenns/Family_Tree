# =============================================================================
# FamilyRoots — Environment Configuration Template
# Copy to .env for local deployment. Set these variables in your hosting environment.
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CLIENT_URL=https://your-domain.example.com

# Database Configuration (MongoDB 6+ or MongoDB Atlas connection string)
# e.g., mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/familyroots?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/familyroots

# Authentication & Security
# Generate a high-entropy secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Media Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
STORAGE_DIR=uploads
MAX_FILE_SIZE_BYTES=52428800
STORAGE_SIGNED_URL_EXPIRES_SECONDS=3600

# S3-Compatible Cloud Object Storage (Required if STORAGE_PROVIDER=s3, e.g. AWS S3, Cloudflare R2, MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Cloudinary Storage (Required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Heritage Insights (Optional — Google Gemini API Key for family story synthesis)
GEMINI_API_KEY=

# Seed Data Control (Optional — false in production prevents demo data seeding)
ALLOW_PRODUCTION_SEED=false

